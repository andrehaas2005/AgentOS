# Postgres
POSTGRES_PASSWORD=troque-esta-senha

# Backend
DATABASE_URL=postgresql://agentos:troque-esta-senha@localhost:5432/agentos
PORT=4000

# Dashboard
NEXT_PUBLIC_API_URL=http://localhost:4000

# Usado a partir da Fase 1 (agentes)
ANTHROPIC_API_KEY=

# Integração Instagram (Graph API) — Fase 2
PUBLIC_BASE_URL=http://localhost:4000
META_GRAPH_VERSION=v24.0
OAUTH_STATE_SECRET=troque-este-segredo

# Integração LinkedIn (Posts API) — Fase 2b
LINKEDIN_API_VERSION=202401

# Basic Auth do nginx só na rota de publicar (build-arg do dashboard) — base64 de "usuario:senha"
NEXT_PUBLIC_PUBLICAR_BASIC=
