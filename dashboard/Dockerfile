FROM node:20-alpine AS base
WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm install

COPY . .

ARG NEXT_PUBLIC_API_URL=""
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ARG NEXT_PUBLIC_PUBLICAR_BASIC=""
ENV NEXT_PUBLIC_PUBLICAR_BASIC=${NEXT_PUBLIC_PUBLICAR_BASIC}
RUN npm run build

EXPOSE 3000
CMD ["npm", "start"]
